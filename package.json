{
  "name": "sententia",
  "version": "1.3.1",
  "description": "Traductor de juegos en tiempo real con OCR",
  "author": "nyzter-zeer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build-portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "overrides": {
    "tar": "^7.5.19",
    "builder-util-runtime": "^9.7.0"
  },
  "build": {
    "appId": "com.nyzter.sententia",
    "productName": "Sententia",
    "copyright": "2026",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sententia"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "lang-data",
        "to": "lang-data",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
